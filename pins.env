# The one place the pins live for the shell recipes (debian, docker CI, SBOM, release).
# flake.nix, guix/aien/omega.scm, aur/PKGBUILD and the Homebrew tap carry the same values;
# scripts/check-pins.sh fails CI when any recipe disagrees with this file.
OMEGA_MV_COMMIT=e5b32567a7aff3ce594e3254a622a846a6cd190b
# sha256 of https://github.com/aien-dev/omega-mv/archive/$OMEGA_MV_COMMIT.tar.gz (GitHub's archive)
OMEGA_MV_TARBALL_SHA256=c621b6cefe728d67a1a253a9d8991495406460d365dd91ea356451eb2254a95c
# sha256 of seed/out/omc after `sh seed/omega-from-seed.sh` (same value as the rung omc row of
# omega-mv seed/challenge/expected.txt); 325524 bytes, static AArch64 Linux ELF
OMC_SHA256=2c82480596bbdc50cda9626866209ef662d5834f278f839ff4ce0250c495029f
OMC_BYTES=325524
# 0.0.0 until omega-mv tags a release; +git.<first 8 hex of the commit>
OMC_VERSION=0.0.0+git.e5b32567
