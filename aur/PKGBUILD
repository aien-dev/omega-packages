# Maintainer: Drake Stapleton <drake@aienos.com>
# omc, the Omega compiler, born from the 408-byte hand-written seed of aien-dev/omega-mv.
# The build runs only seed programs plus sh, printf, sed, stat, cmp and sha256sum; no compiler.
pkgname=omc
_commit=e5b32567a7aff3ce594e3254a622a846a6cd190b
_omcsha256=2c82480596bbdc50cda9626866209ef662d5834f278f839ff4ce0250c495029f
pkgver=0.0.0+git.e5b32567
pkgrel=1
pkgdesc='Omega compiler, born from a 408-byte hand-written seed (AArch64 Linux only)'
arch=('aarch64')
url='https://github.com/aien-dev/omega-mv'
license=('Apache-2.0')
options=('!strip' '!debug')
source=("omega-mv-${_commit}.tar.gz::https://github.com/aien-dev/omega-mv/archive/${_commit}.tar.gz")
sha256sums=('c621b6cefe728d67a1a253a9d8991495406460d365dd91ea356451eb2254a95c')

build() {
  cd "omega-mv-${_commit}"
  sh seed/omega-from-seed.sh
  echo "${_omcsha256}  seed/out/omc" | sha256sum -c -
}

check() {
  cd "omega-mv-${_commit}"
  printf 'global out uchar 4\nfn main to int\nput out 0 111\nput out 1 107\nput out 2 10\nw = write 1 out 0 3\nret 0\nend\n' > hello.om
  ./seed/out/omc < hello.om > hello
  chmod +x hello
  test "$(./hello)" = ok
}

package() {
  cd "omega-mv-${_commit}"
  install -Dm755 seed/out/omc "${pkgdir}/usr/bin/omc"
}
